{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "Firefox ESR",
        "not dead"
    ],
    "engines": {
        "node": ">24.0.0",
        "npm": ">11.0.0"
    },
    "scripts": {
        "prepare": "npm run lararail:build && npm run vite-plugin-watch:build",
        "build": "npm run routes && vite build",
        "build:ssr": "npm run routes && vite build && vite build --ssr",
        "dev": "vite",
        "dev:landlord-a": "VITE_DEV_HOST=landlord-a.rentlynk.dev vite",
        "dev:landlord-b": "VITE_DEV_HOST=landlord-b.rentlynk.dev vite",
        "lint": "oxlint resources/ --type-aware --fix && oxfmt --write resources/",
        "test:lint": "oxlint resources/ --type-aware && oxfmt --check resources/",
        "test:types": "tsc --noEmit",
        "routes": "php artisan app:generate-lararail-routes",
        "lararail:build": "npm --prefix=./packages/lararail ci && npm --prefix=./packages/lararail run build",
        "lararail:install": "npm ci ./packages/lararail",
        "vite-plugin-watch:build": "npm --prefix=./packages/vite-plugin-watch ci && npm --prefix=./packages/vite-plugin-watch run build",
        "vite-plugin-watch:install": "npm ci ./packages/vite-plugin-watch"
    },
    "devDependencies": {
        "@laravel/echo-vue": "^2.3.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "@types/jsdom": "^28.0.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.0.0",
        "@types/pluralize": "^0.0.33",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/language-server": "^3.3.3",
        "@vue/typescript-plugin": "^3.3.3",
        "@vueuse/core": "^14.3.0",
        "concurrently": "^9.0.1",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.53.0",
        "oxlint": "^1.68.0",
        "oxlint-tsgolint": "^0.23.0",
        "pusher-js": "^8.5.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-manifest-sri": "^0.2.0",
        "vite-plugin-oxlint": "^2.1.1",
        "vite-plugin-watch": "file:packages/vite-plugin-watch",
        "vue-tsc": "^3.3.3"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@nuxt/ui": "^4.8.1",
        "@vueuse/core": "^12.8.2",
        "dayjs": "^1.11.21",
        "lararail": "file:packages/lararail",
        "laravel-vite-plugin": "^3.1.0",
        "lodash": "^4.18.1",
        "pinia": "^3.0.4",
        "pinia-plugin-persistedstate": "^4.7.1",
        "pluralize": "^8.0.0",
        "pretty-bytes": "^7.1.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0",
        "ziggy-js": "^2.6.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
