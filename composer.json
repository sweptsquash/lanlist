{
    "name": "jamesread/lanlist",
    "description": "The skeleton application for the Laravel framework.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.2.1",
        "laravel/fortify": "^1.37.3",
        "laravel/framework": "^13.23.0",
        "laravel/horizon": "^5.48.1",
        "laravel/reverb": "^1.11.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.20",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "predis/predis": "^2.4.1",
        "spatie/laravel-activitylog": "^5.0.0",
        "spatie/laravel-medialibrary": "^11.23.3",
        "spatie/laravel-permission": "^7.4.2",
        "spatie/laravel-query-builder": "^7.3.0",
        "spatie/laravel-sluggable": "^3.8.1",
        "tightenco/ziggy": "^2.6.3"
    },
    "require-dev": {
        "ext-pcov": "*",
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "driftingly/rector-laravel": "^2.5.0",
        "ergebnis/composer-normalize": "^2.52.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.13",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.3",
        "laravel/pint": "^1.30.3",
        "laravel/sail": "^1.64",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.5.9"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "./vendor/bin/whisky update > /dev/null 2>&1"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@ide_helper",
            "@doc:models",
            "@php artisan boost:update"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "doc:models": [
            "@php artisan ide-helper:models --dir=\"app/Models/\" -RW",
            "rector",
            "@lint"
        ],
        "ide_helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "lint": "./vendor/bin/pint -p",
        "refactor": "rector",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:arch": "pest --filter=arch",
        "test:lint": "./vendor/bin/pint -p --test",
        "test:refactor": "rector --dry-run",
        "test:type-coverage": "pest --type-coverage --min=99",
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "test:unit": "pest --parallel --recreate-databases --coverage --min=70"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
